// University of Michigan Great Lakes HPC settings. Enable with `-profile greatlakes`.

process {
    executor = 'slurm'
    containerOptions = '--bind "/scratch:/scratch" --bind "/nfs:/nfs" --bind "/gpfs:/gpfs" --bind "/home:/home"'
    clusterOptions = '--account=scjp1'
    beforeScript = 'module load singularity/4.4.1'
}

executor {
    name = 'local'
    cpus = 5
    memory = '32 GB'
}
