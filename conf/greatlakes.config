// University of Michigan Great Lakes HPC settings. Enable with `-profile greatlakes`.

singularity.runOptions = '--nv'

process {
    executor = 'slurm'
    containerOptions = '--bind "/scratch:/scratch" --bind "/nfs:/nfs" --bind "/gpfs:/gpfs" --bind "/home:/home"'
    clusterOptions = '--account=scjp1'
    beforeScript = 'module load singularity/4.4.1'
    withName: CELLBENDER {
        containerOptions = '--nv --bind "/scratch:/scratch" --bind "/nfs:/nfs" --bind "/gpfs:/gpfs" --bind "/home:/home"'
        clusterOptions = '--account=cgates1 --partition=gpu_mig40,gpu --gres=gpu:1'
    }
}

executor {
    name = 'local'
    cpus = 5
    memory = '32 GB'
}

params.chrom_sizes = [
    'hg38': '/scratch/scjp_root/scjp0/shared_data/reference/human/hg38/hg38.chrom_sizes',
    'mm10': '/nfs/mm-isilon/bioinfcore/ActiveProjects/ncarruth/common/reference/10X_references/refdata-cellranger-arc-mm10-2020-A-2.0.0/mm10.chrom_sizes'
]
params.tss = [
    'hg38': '/scratch/scjp_root/scjp0/shared_data/reference/human/hg38/topmed/tss/hg38.gene-name.tss.bed',
    'mm10': '/nfs/mm-isilon/bioinfcore/ActiveProjects/ncarruth/common/reference/10X_references/refdata-cellranger-arc-mm10-2020-A-2.0.0/regions/tss.bed'
]
