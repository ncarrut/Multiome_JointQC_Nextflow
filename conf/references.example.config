// Example reference configuration. Copy this file, fill in the paths for the
// genomes in your samplesheet, and pass it with `-c my_references.config`.
//
// Keys must match the samplesheet's `genome` column. Only multiome and ATAC
// samples need these files (RNA-only samples do not use them).
//
//   tss         : BED of transcription start sites (used by ataqv and the TSS signal plots).
//                 Cell Ranger ARC references ship one at <reference>/regions/tss.bed
//   chrom_sizes : two-column chromosome sizes file (used to build ATAC bigwigs)

params.tss = [
    'hg38': '/path/to/refdata-cellranger-arc-GRCh38/regions/tss.bed',
    'mm10': '/path/to/refdata-cellranger-arc-mm10/regions/tss.bed'
]
params.chrom_sizes = [
    'hg38': '/path/to/hg38.chrom.sizes',
    'mm10': '/path/to/mm10.chrom.sizes'
]
