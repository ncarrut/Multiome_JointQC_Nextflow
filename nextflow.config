nextflowVersion = '>=20.10.0'

trace.enabled = true
report.enabled = true
dag.enabled = true

singularity.enabled = true
singularity.autoMounts = true
singularity.pullTimeout = '1h'

process {
    shell = ['/bin/bash', '-ueo', 'pipefail']
}

process.container = 'docker://ncarrut/singlecell_qc:second'

// assay (multiome/scRNA/snRNA/ATAC) is set per-sample in the samplesheet
params {
    samplesheet = null
    outdir = "results"
    filter_MT_ATAC = false
    // FPR of the upstream CellBender run; used to locate <sample>.cellbender_FPR_<fpr>.h5
    cellbender_fpr = "0.05"
}

profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
    // University of Michigan Great Lakes cluster
    greatlakes {
        includeConfig 'conf/greatlakes.config'
    }
}
