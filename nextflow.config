nextflowVersion = '>=20.10.0'

trace.enabled = true
report.enabled = true
dag.enabled = true

singularity.enabled = true
singularity.autoMounts = true
singularity.pullTimeout = '1h'
singularity.envWhitelist = 'CUDA_VISIBLE_DEVICES,PYTORCH_CUDA_ALLOC_CONF'

process {
    shell = ['/bin/bash', '-ueo', 'pipefail']
    // CellBender runs with --cuda and needs a GPU; --nv exposes it inside the container
    withName: CELLBENDER {
        containerOptions = '--nv'
    }
}


params.samplesheet = null
params.results = "results"
params.cluster_res = 0.5
params.df_pk = 0
// assay (multiome/scRNA/snRNA/ATAC) and genome (e.g. hg38, mm10) are set per-sample in the samplesheet

// Per-genome reference files, keyed by the samplesheet's `genome` value. Required for
// multiome and ATAC samples. Set them with `-c my_references.config` (see
// conf/references.example.config) or use a site profile such as `-profile greatlakes`.
params.tss = [:]
params.chrom_sizes = [:]
params.plot_signal_at_genes = ['GAPDH', 'MYH1', 'MYH2', 'MYH7'] // if these genes exist in the TSS file, ATAC signal near their TSS will be visualized

params.filter_MT_ATAC = true
params.emptydrops_fdr = 0.01
// CellBender is run once at every FPR in cellbender_fprs; cellbender_fpr picks which
// of those results is used downstream (emptyDrops, joint/RNA QC). Must be one of cellbender_fprs.
params.cellbender_fprs = ['0.01', '0.05']
params.cellbender_fpr = "0.05"


profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
    // University of Michigan Great Lakes cluster
    greatlakes {
        includeConfig 'conf/greatlakes.config'
    }
}
